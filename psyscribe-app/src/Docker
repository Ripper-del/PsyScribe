# ЕТАП 1: Збірка (Build)
FROM node:18-alpine as build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# Збираємо продакшн-версію React-додатку
RUN npm run build

# ЕТАП 2: Роздача статики через Nginx
FROM nginx:alpine
# Копіюємо зібрані файли з першого етапу в папку Nginx
COPY --from=build /app/dist /usr/share/nginx/html
# Копіюємо кастомний конфіг Nginx (створимо його нижче)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]