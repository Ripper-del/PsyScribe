# Використовуємо легку версію Node.js
FROM node:18-alpine

# Створюємо робочу директорію в контейнері
WORKDIR /app

# Копіюємо файли залежностей
COPY package*.json ./

# Встановлюємо залежності
RUN npm install

# Копіюємо весь інший код
COPY . .

# Відкриваємо порт 3000
EXPOSE 3000

# Команда для запуску сервера
CMD ["node", "server.js"]